<Window x:Class="Giga3DApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Giga3DApp"
        mc:Ignorable="d"
        Title="GigaChat 3D Asset Generator Pro" Height="700" Width="1200" MinWidth="980" MinHeight="620">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="GigaChat 3D Asset Generator Pro" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Выберите модель" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="ModelComboBox" Height="36" IsEnabled="False"/>

                <TextBlock Text="Описание 3D-объекта" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <TextBox x:Name="PromptTextBox" Height="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                         Text="Создай низкополигональную игровую модель космического кота в стиле Pixar, объемный силуэт, 2-3 основных цвета, мягкие грани, текстура как для Unreal Engine, эффект золота и синего света."/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="LoadModelsButton" Content="Загрузить модели" Width="160" Height="38" Margin="0,0,12,0" Click="LoadModelsButton_Click"/>
                    <Button x:Name="GenerateButton" Content="Сгенерировать 3D" Width="180" Height="38" Click="GenerateButton_Click" IsEnabled="False"/>
                </StackPanel>

                <Button x:Name="OpenModelButton" Content="Открыть 3D-файл" Width="180" Height="36" Margin="0,12,0,0" HorizontalAlignment="Left" Click="OpenModelButton_Click" IsEnabled="False"/>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="8" Padding="12" Background="#FAFBFC">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="StatusText" Text="Готово к работе. Сначала загрузите список моделей из GigaChat API." TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <StatusBar Grid.Row="3" Margin="0,12,0,0" Height="34">
                <StatusBarItem>
                    <TextBlock x:Name="OutputPathText" Text="Путь к файлам: не создан"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>

        <Border Grid.Column="1" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="10" Background="#F8F9FB" Padding="8">
            <Grid>
                <Viewport3D x:Name="Viewport">
                    <ModelVisual3D x:Name="SceneRoot"/>
                </Viewport3D>
                <TextBlock x:Name="PreviewHint" Text="Настоящая 3D-модель будет сохранена в файл. После генерации нажмите «Открыть 3D-файл»." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24" Foreground="#4B5563" FontSize="16"/>
            </Grid>
        </Border>
    </Grid>
</Window>
